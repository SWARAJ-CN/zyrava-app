{
  "expo": {
    "name": "ZYRAVA",
    "slug": "zyrava-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zyrava",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#17111c",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zyrava.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.zyrava.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#17111c"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#17111c",
          "dark": {
            "backgroundColor": "#17111c"
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#10b981"
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "androidForegroundService": true,
          "androidFSTypes": [
            "mediaPlayback"
          ],
          "androidFSStopWithTask": false,
          "androidPermissions": [
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
            "android.permission.POST_NOTIFICATIONS",
            "android.permission.WAKE_LOCK"
          ],
          "enableFFmpeg": true
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
