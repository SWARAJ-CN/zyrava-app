# Copy to .env and fill in real values. Never commit .env.

# Account API (the Express app in ../zyrava-server). Mobile calls it directly —
# the paths match the web app's proxied paths (/api/auth, /api/library,
# /api/community, /api/visits).
# Local: http://<your-lan-ip>:5000 on device · Deployed: https://your-api.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:5000

# Catalogue mirror(s), comma-separated, tried in order — same contract as the
# web app's server-side MUSIC_API. Native networking has no CORS, so the app
# talks to the mirrors itself instead of a /api/music proxy.
EXPO_PUBLIC_MUSIC_API=https://saavn.sumit.co/api

# OPTIONAL: hosted URL of the web app (the deployed ZYRAVA site). When set,
# catalogue/lyrics requests prefer its /api/music/* route handlers — the exact
# code path the browser version used, including the server-side lyrics cache.
# EXPO_PUBLIC_WEB_BASE_URL=https://your-zyrava-site.example.com
